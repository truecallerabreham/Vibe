{
  "name": "arc",
  "version": "0.1.0",
  "description": "Design production-grade architectures by learning from real open-source projects",
  "type": "module",
  "bin": {
    "arc": "dist/index.js"
  },
  "files": [
    "dist/",
    "web/dist/",
    "gitdiagram/backend/app/",
    "gitdiagram/backend/pyproject.toml",
    "gitdiagram/backend/uv.lock",
    "gitdiagram/backend/package.json",
    "gitdiagram/backend/.python-version",
    "gitdiagram/.env.example",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "build:web": "cd web && npm run build",
    "build:all": "npm run build && npm run build:web",
    "postinstall": "node scripts/postinstall.js",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "commander": "^12.0.0",
    "express": "^4.21.0",
    "openai": "^4.73.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.0.0"
  }
}
